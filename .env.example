# Publishable client config — safe to expose, RLS is the security boundary.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Rework flag (R0.7). Its migrations are applied to production; on for local
# and preview builds, off in shipped builds until the rework release (R10.1).
EXPO_PUBLIC_FLOW_V2=false
# 1.2 plan agent (needs EXPO_PUBLIC_FLOW_V2=true and otto-agent deployed)
EXPO_PUBLIC_OTTO_AGENT=false
