{
  "expo": {
    "name": "Otto",
    "slug": "otto",
    "version": "1.0.16",
    "scheme": "otto",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.otto.recipes",
      "buildNumber": "33",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.otto.recipes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#C4562E"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Otto uses your photos to import a recipe or add a plate to your cooking journal.",
          "cameraPermission": "Otto uses your camera to snap a recipe or your finished plate."
        }
      ],
      "expo-notifications",
      "expo-audio",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Otto listens only while you hold the mic, to write down what you said.",
          "speechRecognitionPermission": "Speech recognition turns your words into text for Otto."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f58c8fc1-5a5c-4e3c-b923-cdb4bb37c43c"
      }
    },
    "owner": "black-360"
  }
}
